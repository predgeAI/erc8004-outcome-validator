VITE_PRIVY_APP_ID=cmo7lfg0f000k0cl251pk1m2o
# Dynamic dashboard -> Developers -> SDK and API keys -> Environment ID (Sandbox)
VITE_DYNAMIC_ENV_ID=bf4fc614-b0ae-4976-874e-c470659d07f7
